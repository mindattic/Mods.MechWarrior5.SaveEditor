<UserControl x:Class="Mw5SaveEditor.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mw5SaveEditor.App.Controls">
    <Grid Margin="36,30,36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="RESCAN" Command="{Binding RescanCommand}" Margin="0,0,10,0" />
                <Button Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Button.Command}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Glyph.Open}" Style="{StaticResource Glyph}" Stroke="{StaticResource Brush.Void}" Margin="0,0,8,0" />
                        <TextBlock Text="BROWSE FOR SAVE" Foreground="{StaticResource Brush.Void}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="SELECT CAMPAIGN" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0">
                    <Run Text="Campaigns found in" /> <Run Text="{Binding SaveRoot, Mode=OneWay}" Foreground="{StaticResource Brush.TextFaint}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0" Visibility="{Binding HasCampaigns, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <c:ChamferBorder Style="{StaticResource Panel}" Padding="0,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CAMPAIGNS" Style="{StaticResource Text.Section}" Margin="18,4,18,10" />
                    <ListBox ItemsSource="{Binding Campaigns}" SelectedItem="{Binding SelectedCampaign}" Style="{StaticResource List.Rows}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Background="Transparent" Cursor="Hand">
                                                <Rectangle x:Name="Wash" Fill="{StaticResource Brush.AmberWash}" Opacity="0" />
                                                <Rectangle x:Name="Bar" Width="4" HorizontalAlignment="Left" Fill="{StaticResource Brush.Amber}" Opacity="0" />
                                                <ContentPresenter Margin="18,10" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Wash" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Wash" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="14">
                                        <Run Text="{Binding Saves.Count, Mode=OneWay}" /> <Run Text="saves" />
                                        <Run Text="{Binding CompanyGameDate, Mode=OneWay, StringFormat='  /  {0}'}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </c:ChamferBorder>

            <c:ChamferBorder Grid.Column="2" Style="{StaticResource Panel}" Padding="0,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,4,18,10">
                        <TextBlock Text="DOUBLE-CLICK A SAVE TO OPEN IT" DockPanel.Dock="Right" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding SelectedCampaign.Name, StringFormat='SAVES  //  {0}'}" Style="{StaticResource Text.Section}" />
                    </DockPanel>
                    <ListBox x:Name="Saves" ItemsSource="{Binding SelectedCampaign.Saves}" Style="{StaticResource List.Rows}"
                             MouseDoubleClick="OnSaveDoubleClick" KeyDown="OnSaveKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Background="Transparent" Cursor="Hand">
                                                <Border x:Name="Bg" Background="Transparent" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" />
                                                <ContentPresenter Margin="18,9" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.AmberWash}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Visibility="{Binding IsAutosave, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="AUTO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StarSystem}" Style="{StaticResource Text.Muted}" FontSize="14" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="GAME DATE" Style="{StaticResource Text.Label}" FontSize="11" />
                                        <TextBlock Text="{Binding GameDate}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="REPUTATION" Style="{StaticResource Text.Label}" FontSize="11" />
                                        <TextBlock Text="{Binding Reputation}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="SAVED" Style="{StaticResource Text.Label}" FontSize="11" />
                                        <TextBlock Text="{Binding LastWrite, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="15" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </c:ChamferBorder>
        </Grid>

        <c:ChamferBorder Grid.Row="1" Style="{StaticResource Panel}" Margin="0,22,0,0" VerticalAlignment="Top" Padding="28,24"
                         Visibility="{Binding HasCampaigns, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel>
                <TextBlock Text="NO CAMPAIGNS FOUND" Style="{StaticResource Text.Section}" FontSize="20" />
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Text.Muted}"
                           Text="MW5 Mercenaries keeps campaign saves under %LOCALAPPDATA%\MW5Mercs\Saved\SaveGames. Use Browse to open a .sav from anywhere else (Xbox / Game Pass saves live in a different folder)." />
            </StackPanel>
        </c:ChamferBorder>
    </Grid>
</UserControl>
