<UserControl x:Class="Mech5.SaveEditor.App.Views.MechsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Mech5.SaveEditor.App.Localization"
             xmlns:c="clr-namespace:Mech5.Shared.Wpf.Controls;assembly=Mech5.Shared.Wpf"
             xmlns:b="clr-namespace:Mech5.Shared.Wpf.Behaviors;assembly=Mech5.Shared.Wpf">
    <UserControl.Resources>
        <!-- Mech portrait: Sarna art over a hex badge with the chassis initials while loading/offline. -->
        <DataTemplate x:Key="Portrait">
            <Grid Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}, FallbackValue=92}" Height="70" ClipToBounds="True">
                <Rectangle Fill="{DynamicResource Brush.Void}" />
                <Path Data="M14,0 L42,0 L56,24 L42,48 L14,48 L0,24 Z" Stretch="Uniform" Width="40" Height="34"
                      Stroke="{DynamicResource Brush.LineBright}" StrokeThickness="1.5" Fill="{DynamicResource Brush.Panel}" />
                <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}" />
                <Image b:MechArt.Title="{Binding SarnaTitle}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>

        <Style x:Key="Dlc.Chip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource Brush.OkWash}" />
            <Setter Property="BorderBrush" Value="#6686C25B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDlcOwned}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerWash}" />
                    <Setter Property="BorderBrush" Value="#66E4573D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="380" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="8*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{l:T mech_logistics}" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

        <!-- ================= COMPANY HANGAR ================= -->
        <c:ChamferBorder Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom">
                            <Run Text="{l:T bay}" /> <Run Text="{Binding BayCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" />
                            <Run Text="{l:T cold}" /> <Run Text="{Binding ColdCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" />
                        </TextBlock>
                        <TextBlock Text="{l:T company_hangar}" Style="{StaticResource Text.Section}" FontSize="19" />
                    </DockPanel>
                    <CheckBox Content="{l:T cold_storage_only}" IsChecked="{Binding ShowColdStorageOnly}" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Hangar actions -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="14,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Text.Label}">
                                <Run Text="{Binding HangarSelectedCount, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentHot}" /> <Run Text="{l:T selected}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Button.Link}" Command="{Binding SelectAllHangarCommand}" Margin="0,0,14,0">
                                    <TextBlock Text="{l:T select_all}" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <Button Style="{StaticResource Button.Link}" Command="{Binding ClearHangarSelectionCommand}">
                                    <TextBlock Text="{l:T clear}" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <Button Command="{Binding EditLoadoutCommand}" Style="{StaticResource Button.Command}" Margin="0,0,0,8"
                                ToolTip="{l:T weapons_equipment_and_armor_for_the_ticked_mech_}">
                            <TextBlock Text="{l:T edit_loadout}" FontWeight="Bold" Foreground="{DynamicResource Brush.Void}" />
                        </Button>
                        <UniformGrid Columns="2">
                            <Button Command="{Binding RepairSelectedCommand}" Margin="0,0,4,8" ToolTip="{l:T restore_armor_structure_and_component_health}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Glyph.Repair}" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T repair}" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RepairAllCommand}" Margin="4,0,0,8" ToolTip="{l:T repair_every_mech_the_company_owns}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Glyph.Repair}" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T repair_all}" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ResetSelectedCommand}" Margin="0,0,4,0" ToolTip="{l:T replace_the_loadout_with_the_factory_configurati}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Glyph.Reset}" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T stock_loadout}" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveSelectedCommand}" Style="{StaticResource Button.Danger}" Margin="4,0,0,0" ToolTip="{l:T remove_selected_cold_storage_mechs}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Glyph.Trash}" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T remove_2}" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding HangarView}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}"
                         b:CheckList.IsEnabled="True" Margin="8,0,4,0" MouseDoubleClick="OnHangarDoubleClick"
                         ToolTip="{l:T double_click_a_mech_to_open_it_in_the_mech_lab}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Focusable="False" />
                                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource Portrait}" Tag="80" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Code}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentHot}" />
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Muted}" FontSize="15" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Glyph.Snowflake}" Stroke="{DynamicResource Brush.Info}" StrokeThickness="1.4" Width="11" Height="11"
                                                  Stretch="Uniform" Margin="0,0,5,0" Visibility="{Binding IsColdStorage, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding LocationLabel}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Margin="0,4,0,0" HorizontalAlignment="Right" Background="{DynamicResource Brush.AccentWash}"
                                            BorderBrush="{DynamicResource Brush.Accent}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{l:T new}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentHot}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </c:ChamferBorder>

        <!-- ================= REQUISITION ================= -->
        <c:ChamferBorder Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,14,18,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom">
                            <Run Text="{Binding VisibleCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" /> <Run Text="{l:T shown}" />
                        </TextBlock>
                        <TextBlock Text="{l:T requisition_add_to_cold_storage}" Style="{StaticResource Text.Section}" FontSize="19" />
                    </DockPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}" Padding="32,0,8,0"
                                     Tag="{l:T search_code_chassis_hero_or_dlc}" />
                            <Path Data="{StaticResource Glyph.Search}" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.6" Width="14" Height="14"
                                  Stretch="Uniform" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" DisplayMemberPath="Label" />
                    </Grid>

                    <WrapPanel Margin="0,10,0,0">
                        <ToggleButton Style="{StaticResource Toggle.Chip}" Content="{l:T light}" IsChecked="{Binding LightChecked}" />
                        <ToggleButton Style="{StaticResource Toggle.Chip}" Content="{l:T medium}" IsChecked="{Binding MediumChecked}" />
                        <ToggleButton Style="{StaticResource Toggle.Chip}" Content="{l:T heavy}" IsChecked="{Binding HeavyChecked}" />
                        <ToggleButton Style="{StaticResource Toggle.Chip}" Content="{l:T assault}" IsChecked="{Binding AssaultChecked}" />
                        <ToggleButton Style="{StaticResource Toggle.Chip}" Content="{l:T heroes}" IsChecked="{Binding HeroesOnly}" Margin="10,0,6,0" />
                        <ToggleButton Style="{StaticResource Toggle.Chip}" Content="{l:T owned_dlc_only}" IsChecked="{Binding OwnedDlcOnly}"
                                      IsEnabled="{Binding HasDlcInfo}" ToolTip="{l:T hide_mechs_from_dlc_this_campaign_doesn_t_have}" />
                        <Button Style="{StaticResource Button.Link}" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{l:T reset_filters}" FontWeight="Bold" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- Footer: batch add (two rows so long translations never overlap) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Style="{StaticResource Button.Link}" Command="{Binding SelectAllVisibleCommand}" Margin="0,0,16,0" ToolTip="{l:T ctrl_a_in_the_list}">
                                <TextBlock Text="{l:T select_all_shown}" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button Style="{StaticResource Button.Link}" Command="{Binding ClearSelectionCommand}" Margin="0,0,16,0">
                                <TextBlock Text="{l:T clear}" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentHot}" /> <Run Text="{l:T selected}" />
                            </TextBlock>
                        </WrapPanel>
                        <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding AddSelectedCommand}" Style="{StaticResource Button.Command}" Height="42" Padding="22,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Glyph.Plus}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Brush.Void}" StrokeThickness="2.2" Margin="0,0,10,0" />
                                <TextBlock FontWeight="Bold" FontSize="19" Foreground="{DynamicResource Brush.Void}">
                                    <Run Text="{l:T add}" /> <Run Text="{Binding SelectedCount, Mode=OneWay}" /> <Run Text="{l:T to_cold_storage}" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="{l:T copies_each}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Width="56" HorizontalContentAlignment="Center" />
                        </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Column header -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Void}" Margin="8,4,12,2" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding AllVisibleChecked}" IsThreeState="False" ToolTip="{l:T select_every_mech_shown_ctrl_a}" />
                        <TextBlock Grid.Column="2" Text="{l:T variant}" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="3" Text="{l:T tons}" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="4" Text="{l:T class}" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="5" Text="{l:T source}" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="6" Text="{l:T owned}" Style="{StaticResource Text.Label}" />
                    </Grid>
                </Border>

                <ListBox ItemsSource="{Binding CatalogView}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}"
                         b:CheckList.IsEnabled="True" Margin="8,0,4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Focusable="False" />
                                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource Portrait}" Tag="92" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <TextBlock Text="{Binding Code}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentHot}" />
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Muted}" FontSize="15" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Variant.Tons}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding ClassLabel}" FontSize="17" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                                <Border Grid.Column="5" HorizontalAlignment="Left" Style="{StaticResource Dlc.Chip}" ToolTip="{Binding DlcName}"
                                        Visibility="{Binding DlcCode, Converter={StaticResource HasValueToVisibility}}">
                                    <TextBlock Text="{Binding DlcCode}" FontSize="14" FontWeight="Bold" />
                                </Border>
                                <TextBlock Grid.Column="5" Text="{l:T base}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextFaint}"
                                           Visibility="{Binding DlcCode, Converter={StaticResource HasValueToVisibility}, ConverterParameter=Invert}" />
                                <TextBlock Grid.Column="6" VerticalAlignment="Center" FontSize="17" FontWeight="Bold"
                                           Visibility="{Binding OwnedCount, Converter={StaticResource HasValueToVisibility}}">
                                    <Run Text="x" Foreground="{DynamicResource Brush.TextMuted}" /><Run Text="{Binding OwnedCount, Mode=OneWay}" />
                                </TextBlock>
                                <Button Grid.Column="7" Style="{StaticResource Button.Link}" Click="OnOpenSarna" Tag="{Binding SarnaUrl}"
                                        ToolTip="{Binding SarnaTitle, StringFormat='Open {0} on Sarna.net'}" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Glyph.Link}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </c:ChamferBorder>
    </Grid>
</UserControl>
