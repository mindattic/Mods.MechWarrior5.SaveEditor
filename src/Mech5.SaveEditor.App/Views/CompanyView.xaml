<UserControl x:Class="Mech5.SaveEditor.App.Views.CompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Mech5.SaveEditor.App.Localization"
             xmlns:c="clr-namespace:Mech5.Shared.Wpf.Controls;assembly=Mech5.Shared.Wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,22,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="{l:T company_overview}" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

            <!-- Identity & finances -->
            <c:ChamferBorder Grid.Row="1" Style="{StaticResource Panel}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T identity}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{l:T company_name}" Style="{StaticResource Text.Label}" Margin="0,14,0,4" />
                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=LostFocus}" FontSize="20" />

                    <TextBlock Text="{l:T reputation}" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
                    <TextBox Text="{Binding Reputation, UpdateSourceTrigger=LostFocus}" Width="180" HorizontalAlignment="Left" />

                    <TextBlock Text="{l:T campaign_date}" Style="{StaticResource Text.Label}" Margin="0,16,0,2" />
                    <TextBlock Text="{Binding CampaignDate}" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Width="150" Tag="{l:T yyyy_mm_dd}" />
                        <Button Content="{l:T move_calendar}" Command="{Binding MoveDateCommand}" Margin="8,0,0,0"
                                ToolTip="{l:T shifts_today_and_every_dated_event_together_so_t}" />
                    </StackPanel>

                    <TextBlock Text="{l:T transfer}" Style="{StaticResource Text.Section}" Margin="0,22,0,0" />
                    <TextBlock Text="{l:T move_mechs_pilots_and_stock_between_campaigns}" Style="{StaticResource Text.Muted}" FontSize="16" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:T export_company}" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:T import_company}" Command="{Binding ImportCommand}" />
                    </StackPanel>

                    <TextBlock Text="{l:T cantinas}" Style="{StaticResource Text.Section}" Margin="0,22,0,6"
                               Visibility="{Binding HasCantinas, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Content="{l:T cantinas_unlocked}" IsChecked="{Binding CantinasUnlocked}"
                              Visibility="{Binding HasCantinas, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="{l:T opens_the_cantinas_without_waiting_for_the_story}" />

                    <StackPanel Visibility="{Binding HasMechTraits, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:T mech_traits_unlocked}" Style="{StaticResource Text.Section}" Margin="0,22,0,6" />
                <ItemsControl ItemsSource="{Binding UnlockedTraits}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Height="28" Margin="0,0,6,6" Padding="8,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource Button.Link}" Margin="8,0,0,0" ToolTip="{l:T remove}" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.LockTraitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource Glyph.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="{l:T add}" Command="{Binding UnlockTraitCommand}" Margin="8,0,0,0" />
                            <ComboBox ItemsSource="{Binding TraitChoices}" SelectedItem="{Binding UnlockToAdd}" DisplayMemberPath="Label" MaxDropDownHeight="380" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </c:ChamferBorder>

            <c:ChamferBorder Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T finances}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{l:T available_c_bills}" Style="{StaticResource Text.Label}" Margin="0,14,0,2" />
                    <TextBlock Text="{Binding CBillsText}" Style="{StaticResource Text.Readout}" FontSize="42" />
                    <TextBlock Text="{l:T set_exact_amount}" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding CBills, UpdateSourceTrigger=LostFocus}" Width="260" HorizontalAlignment="Left" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="{l:T 1m}" Command="{Binding AddCBillsCommand}" CommandParameter="1000000" Margin="0,0,8,8" MinWidth="80" />
                        <Button Content="{l:T 10m}" Command="{Binding AddCBillsCommand}" CommandParameter="10000000" Margin="0,0,8,8" MinWidth="80" />
                        <Button Content="{l:T 100m}" Command="{Binding AddCBillsCommand}" CommandParameter="100000000" Margin="0,0,8,8" MinWidth="80" />
                        <Button Content="{l:T max}" Command="{Binding MaxCBillsCommand}" Style="{StaticResource Button.Command}" Margin="0,0,8,8" MinWidth="80"
                                ToolTip="{l:T 2_000_000_000_the_largest_amount_the_game_displa}" />
                    </WrapPanel>
                </StackPanel>
            </c:ChamferBorder>

            <!-- Readouts -->
            <c:ChamferBorder Grid.Row="2" Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T assets}" Style="{StaticResource Text.Section}" />
                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T mechbay}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding MechBayCount}" Style="{StaticResource Text.Readout}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T cold_storage}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding ColdStorageCount}" Style="{StaticResource Text.Readout}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T pilots}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding PilotCount}" Style="{StaticResource Text.Readout}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T items}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding ItemCount}" Style="{StaticResource Text.Readout}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </c:ChamferBorder>

            <c:ChamferBorder Grid.Row="2" Grid.Column="2" Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T dlc_content}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding DlcNote}" Style="{StaticResource Text.Muted}" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <ItemsControl ItemsSource="{Binding Dlcs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" Width="56" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Code}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" FontWeight="Bold" FontSize="15" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="NOT IN CAMPAIGN" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Owned}" Value="True">
                                                        <Setter Property="Text" Value="ACTIVE" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontSize="17" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </c:ChamferBorder>
        </Grid>
    </ScrollViewer>
</UserControl>
