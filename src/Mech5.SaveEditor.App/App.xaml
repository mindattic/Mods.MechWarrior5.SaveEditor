<Application x:Class="Mech5.SaveEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Mech5.SaveEditor.App.ViewModels"
             xmlns:v="clr-namespace:Mech5.SaveEditor.App.Views"
             xmlns:cvm="clr-namespace:Mech5.SaveEditor.App.Clans.ViewModels"
             xmlns:cv="clr-namespace:Mech5.SaveEditor.App.Clans.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Mech5.Shared.Wpf;component/Theme/Mech5Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One shell per game; the window's title bar switches between them. -->
            <DataTemplate DataType="{x:Type vm:MainViewModel}"><v:MercsShell /></DataTemplate>
            <DataTemplate DataType="{x:Type cvm:ClansMainViewModel}"><cv:ClansShell /></DataTemplate>

            <DataTemplate DataType="{x:Type cvm:StartViewModel}"><cv:ClansStartView /></DataTemplate>
            <DataTemplate DataType="{x:Type cvm:ResourcesViewModel}"><cv:ClansResourcesView /></DataTemplate>
            <DataTemplate DataType="{x:Type cvm:MechsViewModel}"><cv:ClansMechsView /></DataTemplate>
            <DataTemplate DataType="{x:Type cvm:InventoryViewModel}"><cv:ClansInventoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type cvm:ProgressViewModel}"><cv:ClansProgressView /></DataTemplate>
            <DataTemplate DataType="{x:Type cvm:SettingsViewModel}"><cv:ClansSettingsView /></DataTemplate>

            <DataTemplate DataType="{x:Type vm:StartViewModel}"><v:StartView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompanyViewModel}"><v:CompanyView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MechsViewModel}"><v:MechsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><v:InventoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PilotsViewModel}"><v:PilotsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FactionsViewModel}"><v:FactionsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
