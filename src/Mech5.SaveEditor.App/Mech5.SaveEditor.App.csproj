<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Mech5.SaveEditor.App</RootNamespace>
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <AssemblyName>MW5SaveEditor</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mech5.Mercs.SaveEditor.Core\Mech5.Mercs.SaveEditor.Core.csproj" />
    <ProjectReference Include="..\Mech5.Clans.SaveEditor.Core\Mech5.Clans.SaveEditor.Core.csproj" />
    <ProjectReference Include="..\..\shared\src\Mech5.Shared.Wpf\Mech5.Shared.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="Mech5.SaveEditor.App.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Mech5.Shared.Wpf.Services" />
    <Using Include="Mech5.Shared.Wpf.ViewModels" />
  </ItemGroup>

</Project>
