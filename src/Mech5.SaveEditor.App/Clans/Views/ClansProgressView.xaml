<UserControl x:Class="Mech5.SaveEditor.App.Clans.Views.ClansProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mech5.Shared.Wpf.Controls;assembly=Mech5.Shared.Wpf">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="CAMPAIGN PROGRESS" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

        <c:ChamferBorder Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Panel}">
            <UniformGrid Columns="4">
                <StackPanel>
                    <TextBlock Text="HONOR LEVEL" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding HonorLevel, TargetNullValue='-'}" Style="{StaticResource Text.Readout}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="HONOR EXPERIENCE" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding HonorExperience, StringFormat=N0, TargetNullValue='-'}" Style="{StaticResource Text.Readout}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="CYCLES ELAPSED" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding Cycles, TargetNullValue='-'}" Style="{StaticResource Text.Readout}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="TECHNICIAN POOL" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding Technicians, TargetNullValue='-'}" Style="{StaticResource Text.Readout}" />
                </StackPanel>
            </UniformGrid>
        </c:ChamferBorder>

        <c:ChamferBorder Grid.Row="3" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="RESEARCH QUEUE" Style="{StaticResource Text.Section}" FontSize="19" Margin="18,14,18,8" />
                <ListBox ItemsSource="{Binding Queue}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}" Margin="8,0,4,8" />
            </DockPanel>
        </c:ChamferBorder>

        <c:ChamferBorder Grid.Row="3" Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="COMPLETED RESEARCH" Style="{StaticResource Text.Section}" FontSize="19" Margin="18,14,18,8" />
                <ListBox ItemsSource="{Binding Completed}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}" Margin="8,0,4,8" />
            </DockPanel>
        </c:ChamferBorder>
    </Grid>
</UserControl>
