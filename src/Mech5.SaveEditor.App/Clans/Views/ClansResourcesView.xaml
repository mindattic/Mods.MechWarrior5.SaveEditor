<UserControl x:Class="Mech5.SaveEditor.App.Clans.Views.ClansResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mech5.Shared.Wpf.Controls;assembly=Mech5.Shared.Wpf">
    <UserControl.Resources>
        <!-- One editable amount with quick-add steps. -->
        <DataTemplate x:Key="AmountTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Muted}" FontSize="14" TextWrapping="Wrap"
                               Visibility="{Binding Hint, Converter={StaticResource HasValueToVisibility}}" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Height="32"
                         HorizontalContentAlignment="Right" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="+10" Command="{Binding AddCommand}" CommandParameter="10" Margin="0,0,4,0" Padding="8,4" />
                    <Button Content="+100" Command="{Binding AddCommand}" CommandParameter="100" Margin="0,0,4,0" Padding="8,4" />
                    <Button Content="+1K" Command="{Binding AddCommand}" CommandParameter="1000" Padding="8,4" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Center"
                        Visibility="{Binding HonorLevel, Converter={StaticResource HasValueToVisibility}}">
                    <TextBlock Text="{Binding HonorLevel, StringFormat='HONOR LEVEL {0}'}" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentHot}" />
                </Border>
                <TextBlock Text="RESOURCES" Style="{StaticResource Text.Title}" />
            </DockPanel>

            <c:ChamferBorder Grid.Row="1" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="CURRENCIES" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Currencies}" ItemTemplate="{StaticResource AmountTemplate}" />
                </StackPanel>
            </c:ChamferBorder>

            <c:ChamferBorder Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="SALVAGE" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Salvage}" ItemTemplate="{StaticResource AmountTemplate}" />
                </StackPanel>
            </c:ChamferBorder>

            <c:ChamferBorder Grid.Row="3" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="CREW" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding CrewRows}" ItemTemplate="{StaticResource AmountTemplate}" />
                </StackPanel>
            </c:ChamferBorder>

            <c:ChamferBorder Grid.Row="3" Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="MECH EXPERIENCE (MXP)" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,4" />
                    <TextBlock Text="Per-chassis experience spent on mech upgrades." Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding MechXp}" ItemTemplate="{StaticResource AmountTemplate}" />
                </StackPanel>
            </c:ChamferBorder>
        </Grid>
    </ScrollViewer>
</UserControl>
