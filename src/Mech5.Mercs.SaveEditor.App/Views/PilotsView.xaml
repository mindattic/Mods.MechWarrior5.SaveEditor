<UserControl x:Class="Mech5.Mercs.SaveEditor.App.Views.PilotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mech5.Shared.Wpf.Controls;assembly=Mech5.Shared.Wpf">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="HEAL ALL" Command="{Binding HealAllCommand}" Margin="0,0,10,0" />
                <Button Content="MAX ALL SKILL CAPS" Command="{Binding MaxAllCapsCommand}" />
            </StackPanel>
            <TextBlock Text="MECHWARRIOR ROSTER" Style="{StaticResource Text.Title}" />
        </DockPanel>

        <c:ChamferBorder Grid.Row="1" Style="{StaticResource Panel}" Padding="0,10">
            <ListBox ItemsSource="{Binding Pilots}" SelectedItem="{Binding Selected}" Style="{StaticResource List.Rows}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Background="Transparent" Cursor="Hand">
                                        <Rectangle x:Name="Wash" Fill="{StaticResource Brush.AmberWash}" Opacity="0" />
                                        <Rectangle x:Name="Bar" Width="4" HorizontalAlignment="Left" Fill="{StaticResource Brush.Amber}" Opacity="0" />
                                        <ContentPresenter Margin="16,10" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Wash" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Wash" Property="Opacity" Value="1" />
                                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Grid Width="44" Height="44" Margin="0,0,12,0">
                                <Path Data="M11,0 L33,0 L44,22 L33,44 L11,44 L0,22 Z" Fill="{StaticResource Brush.Void}" Stroke="{StaticResource Brush.LineBright}" StrokeThickness="1.5" />
                                <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Brush.Amber}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="COMMANDER  " FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Amber}"
                                               Visibility="{Binding IsPlayer, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Health}" FontSize="13" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </c:ChamferBorder>

        <c:ChamferBorder Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="24,18" DataContext="{Binding Selected}"
                         Visibility="{Binding Converter={StaticResource HasValueToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="HEAL" Command="{Binding HealCommand}" Margin="0,0,8,0" />
                        <Button Content="MAX SKILL CAPS" Command="{Binding MaxCapsCommand}" Style="{StaticResource Button.Command}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" FontSize="26" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="MONTHLY SALARY" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding Salary, UpdateSourceTrigger=LostFocus}" Width="150" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,22,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SKILL" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="SKILL CAP (0-10)" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="2" Text="TOTAL XP" Style="{StaticResource Text.Label}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Skills}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsParent}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <DockPanel Grid.Column="1" Margin="0,0,24,0" Visibility="{Binding HasCap, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Cap}" Width="30" TextAlignment="Right" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.AmberHot}" VerticalAlignment="Center" />
                                        <Slider Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Cap}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBox Grid.Column="2" Text="{Binding Experience, UpdateSourceTrigger=LostFocus}" Height="32" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </c:ChamferBorder>
    </Grid>
</UserControl>
