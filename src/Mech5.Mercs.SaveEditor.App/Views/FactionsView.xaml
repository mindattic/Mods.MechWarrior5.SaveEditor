<UserControl x:Class="Mech5.Mercs.SaveEditor.App.Views.FactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Mech5.Mercs.SaveEditor.App.Localization"
             xmlns:c="clr-namespace:Mech5.Shared.Wpf.Controls;assembly=Mech5.Shared.Wpf">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{l:T all_neutral_0}" Command="{Binding SetAllCommand}" CommandParameter="0" Margin="0,0,10,0" />
                <Button Content="{l:T all_allied_100}" Command="{Binding SetAllCommand}" CommandParameter="100" Style="{StaticResource Button.Command}" />
            </StackPanel>
            <TextBlock Text="{l:T faction_standing}" Style="{StaticResource Text.Title}" />
        </DockPanel>

        <c:ChamferBorder Grid.Row="1" Style="{StaticResource Panel}" Padding="10,10,4,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Factions}" Margin="8,0,12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />

                                    <!-- Standing meter: center line, red to the left, amber to the right -->
                                    <Grid Grid.Column="1" Margin="0,0,24,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.ColumnSpan="2" Height="6" Fill="{DynamicResource Brush.Void}" VerticalAlignment="Center" />
                                        <Grid x:Name="NegativeHalf">
                                            <Rectangle Height="6" Fill="{DynamicResource Brush.Danger}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Rectangle.Width>
                                                    <MultiBinding Converter="{StaticResource StandingToWidth}" ConverterParameter="Negative">
                                                        <Binding Path="Standing" />
                                                        <Binding Path="ActualWidth" ElementName="NegativeHalf" />
                                                    </MultiBinding>
                                                </Rectangle.Width>
                                            </Rectangle>
                                        </Grid>
                                        <Grid x:Name="PositiveHalf" Grid.Column="1">
                                            <Rectangle Height="6" Fill="{DynamicResource Brush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Rectangle.Width>
                                                    <MultiBinding Converter="{StaticResource StandingToWidth}" ConverterParameter="Positive">
                                                        <Binding Path="Standing" />
                                                        <Binding Path="ActualWidth" ElementName="PositiveHalf" />
                                                    </MultiBinding>
                                                </Rectangle.Width>
                                            </Rectangle>
                                        </Grid>
                                        <Rectangle Grid.ColumnSpan="2" Width="2" Height="16" Fill="{DynamicResource Brush.LineBright}" HorizontalAlignment="Center" />
                                        <Slider Grid.ColumnSpan="2" Minimum="-100" Maximum="100" Value="{Binding Standing}" IsSnapToTickEnabled="True"
                                                TickFrequency="1" VerticalAlignment="Center" Opacity="0.01" Cursor="Hand" ToolTip="{l:T drag_to_set_standing}" />
                                    </Grid>

                                    <TextBox Grid.Column="2" Text="{Binding Standing, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"
                                             HorizontalContentAlignment="Center" Height="32" />
                                    <TextBlock Grid.Column="3" Text="{Binding Mood}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </c:ChamferBorder>
    </Grid>
</UserControl>
