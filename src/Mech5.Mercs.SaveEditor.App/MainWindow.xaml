<Window x:Class="Mech5.Mercs.SaveEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Mech5.Shared.Wpf.Controls;assembly=Mech5.Shared.Wpf"
        xmlns:vm="clr-namespace:Mech5.Mercs.SaveEditor.App.ViewModels"
        Title="{Binding WindowTitle}" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.Base}"
        FontFamily="{StaticResource Font.Hud}" Icon="Assets/app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Background="{StaticResource Brush.Void}">
            <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/app.ico" Width="20" Height="20" Margin="0,0,10,0" />
                <TextBlock Text="MW5 MERCS" FontWeight="Bold" FontSize="17" Foreground="{StaticResource Brush.Amber}" />
                <TextBlock Text="  //  SAVE EDITOR" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource Brush.TextMuted}" />
                <TextBlock Text="{Binding FileName, StringFormat='   [{0}]'}" FontSize="15" Foreground="{StaticResource Brush.TextFaint}"
                           Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                <TextBlock Text="  UNSAVED CHANGES" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Brush.AmberHot}" VerticalAlignment="Center"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Chrome}" Click="OnMinimize" ToolTip="Minimize">
                    <Path Data="{StaticResource Glyph.Minimize}" Style="{StaticResource Glyph}" Width="11" Height="11" />
                </Button>
                <Button Style="{StaticResource Button.Chrome}" Click="OnMaximize" ToolTip="Maximize">
                    <Path Data="{StaticResource Glyph.Maximize}" Style="{StaticResource Glyph}" Width="11" Height="11" />
                </Button>
                <Button Style="{StaticResource Button.ChromeClose}" Click="OnClose" ToolTip="Close">
                    <Path Data="{StaticResource Glyph.Close}" Style="{StaticResource Glyph}" Width="11" Height="11" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Grid Background="{StaticResource Brush.Void}">
                <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,22,18,18" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="MERCENARY COMPANY" Style="{StaticResource Text.Label}" FontSize="12" />
                        <TextBlock Text="{Binding Company.CompanyName}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,12" />
                        <TextBlock Text="C-BILLS" Style="{StaticResource Text.Label}" FontSize="12" />
                        <TextBlock Text="{Binding Company.CBillsText}" Style="{StaticResource Text.Readout}" />
                        <TextBlock Text="{Binding Company.CampaignDate}" Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,18">
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource Button.Command}" Margin="0,0,0,8" ToolTip="Ctrl+S - keeps the previous file as .bak">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Glyph.Save}" Style="{StaticResource Glyph}" Stroke="{StaticResource Brush.Void}" Margin="0,0,8,0" />
                                <TextBlock Text="SAVE" Foreground="{StaticResource Brush.Void}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding SaveAsCommand}" Content="SAVE AS" ToolTip="Ctrl+Shift+S" />
                            <Button Grid.Column="2" Command="{Binding BrowseCommand}" Content="OPEN" ToolTip="Ctrl+O" />
                        </Grid>
                        <Button Command="{Binding CloseCommand}" Content="CAMPAIGNS" Margin="0,8,0,0"
                                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0" IsEnabled="{Binding HasDocument}">
                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Company}"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Company}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Glyph.Company}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                                <TextBlock Text="COMPANY" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Mechs}"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Mechs}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Glyph.Mech}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                                <TextBlock Text="MECHS" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Inventory}"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Inventory}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Glyph.Inventory}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                                <TextBlock Text="INVENTORY" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Pilots}"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Pilots}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Glyph.Pilot}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                                <TextBlock Text="PILOTS" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Factions}"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Factions}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Glyph.Faction}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                                <TextBlock Text="FACTIONS" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Page -->
            <Grid Grid.Column="1" Background="{StaticResource Brush.Base}">
                <Rectangle Fill="{StaticResource Brush.Grid}" />
                <ContentControl Content="{Binding CurrentView}" Focusable="False" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Background="{StaticResource Brush.Void}">
            <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" />
            <TextBlock Text="{Binding Toast}" Margin="16,0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                <TextBlock Text="{Binding DlcSummary}" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,18,0" />
                <TextBlock Text="{Binding Company.GameVersion, StringFormat='GAME v{0}'}" VerticalAlignment="Center" FontSize="14"
                           Foreground="{StaticResource Brush.TextFaint}" Visibility="{Binding Company.GameVersion, Converter={StaticResource HasValueToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
