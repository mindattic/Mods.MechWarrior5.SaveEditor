<Application x:Class="Mech5.Mercs.SaveEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Mech5.Mercs.SaveEditor.App.ViewModels"
             xmlns:v="clr-namespace:Mech5.Mercs.SaveEditor.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Mech5.Shared.Wpf;component/Theme/Mech5Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:StartViewModel}"><v:StartView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompanyViewModel}"><v:CompanyView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MechsViewModel}"><v:MechsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><v:InventoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PilotsViewModel}"><v:PilotsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FactionsViewModel}"><v:FactionsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
