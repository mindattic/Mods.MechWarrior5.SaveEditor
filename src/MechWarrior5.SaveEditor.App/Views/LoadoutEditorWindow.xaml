<Window xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Views.LoadoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sw="clr-namespace:MechWarrior5.Shared.Wpf.Controls;assembly=MechWarrior5.Shared.Wpf"
        xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization"
        xmlns:b="clr-namespace:MechWarrior5.Shared.Wpf.Behaviors;assembly=MechWarrior5.Shared.Wpf"
        xmlns:vm="clr-namespace:MechWarrior5.SaveEditor.App.ViewModels"
        Title="{Binding Title}" Width="1080" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource Font.Hud}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="86" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="GroupBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="ToolTip" Value="{l:T weapon_group}" />
        </Style>
    </Window.Resources>

    <!-- The same chamfered frame as every dialog (top-left and bottom-right cut); ClipToShape keeps the header and
         footer bands inside the cuts. -->
    <ma:MaShapeBorder Style="{StaticResource Panel}" Chamfer="18" Padding="1.5" Fill="{DynamicResource Brush.Base}"
                      Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" ClipToShape="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Background="{DynamicResource Brush.Void}">
                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" />
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <ma:MaButton Style="{StaticResource Button.Picture}" CommandParameter="{Binding SarnaTitle}" ToolTip="{l:T click_to_enlarge}"
                                 Width="84" Height="64" Margin="0,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Rectangle Fill="{DynamicResource Brush.Panel}" />
                            <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                            <Image b:MechArt.Title="{Binding SarnaTitle}" Stretch="Uniform" Margin="2" />
                        </Grid>
                    </ma:MaButton>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T mech_lab}" Style="{StaticResource Text.Label}" FontSize="14" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="28" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <ma:MaButton Style="{StaticResource Toggle.Chip}" Content="{l:T weapons}" Command="{Binding ShowTabCommand}"
                                  CommandParameter="{x:Static vm:LoadoutTab.Weapons}"
                                  IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Weapons}" />
                    <ma:MaButton Style="{StaticResource Toggle.Chip}" Content="{l:T equipment}" Command="{Binding ShowTabCommand}"
                                  CommandParameter="{x:Static vm:LoadoutTab.Equipment}"
                                  IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Equipment}" />
                    <ma:MaButton Style="{StaticResource Toggle.Chip}" Content="{l:T armor}" Command="{Binding ShowTabCommand}"
                                  CommandParameter="{x:Static vm:LoadoutTab.Armor}"
                                  IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Armor}" />
                    <ma:MaButton Style="{StaticResource Toggle.Chip}" Content="{l:T traits}" Command="{Binding ShowTabCommand}"
                                  CommandParameter="{x:Static vm:LoadoutTab.Traits}"
                                  IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Traits}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Rectangle Fill="{DynamicResource Brush.Grid}" />

                <!-- Weapons -->
                <ma:MaShapeBorder Margin="20,18" Padding="0,10">
                    <ma:MaShapeBorder.Style>
                        <Style TargetType="ma:MaShapeBorder" BasedOn="{StaticResource Panel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab}" Value="Weapons">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ma:MaShapeBorder.Style>
                    <!-- One shared width for the hardpoint column: every chip is as wide as the widest (Ballistic, Missile, ...). -->
                    <DockPanel Grid.IsSharedSizeScope="True">
                        <Grid DockPanel.Dock="Top" Margin="20,4,20,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Hardpoint" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T location}" Style="{StaticResource Text.Label}" />
                            <TextBlock Grid.Column="1" Text="{l:T hardpoint}" Style="{StaticResource Text.Label}" Margin="0,0,20,0" />
                            <TextBlock Grid.Column="2" Text="{l:T weapon}" Style="{StaticResource Text.Label}" />
                            <TextBlock Grid.Column="3" Text="{l:T weapon_groups_1_6}" Style="{StaticResource Text.Label}" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Weapons}" Margin="20,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Hardpoint" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="190" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Location}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Style="{StaticResource Chip}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,20,0">
                                                    <TextBlock Text="{Binding ClassLabel}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentHot}" HorizontalAlignment="Center" />
                                                </Border>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Margin="0,0,16,0"
                                                          MaxDropDownHeight="420" ToolTip="{Binding Slot}">
                                                    <ComboBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel />
                                                        </ItemsPanelTemplate>
                                                    </ComboBox.ItemsPanel>
                                                </ComboBox>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource GroupBox}" IsChecked="{Binding Groups[0]}" />
                                                    <CheckBox Style="{StaticResource GroupBox}" IsChecked="{Binding Groups[1]}" />
                                                    <CheckBox Style="{StaticResource GroupBox}" IsChecked="{Binding Groups[2]}" />
                                                    <CheckBox Style="{StaticResource GroupBox}" IsChecked="{Binding Groups[3]}" />
                                                    <CheckBox Style="{StaticResource GroupBox}" IsChecked="{Binding Groups[4]}" />
                                                    <CheckBox Style="{StaticResource GroupBox}" IsChecked="{Binding Groups[5]}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </ma:MaShapeBorder>

                <!-- Equipment -->
                <ma:MaShapeBorder Margin="20,18" Padding="0,10">
                    <ma:MaShapeBorder.Style>
                        <Style TargetType="ma:MaShapeBorder" BasedOn="{StaticResource Panel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab}" Value="Equipment">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ma:MaShapeBorder.Style>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="20,4,20,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T location}" Style="{StaticResource Text.Label}" />
                            <TextBlock Grid.Column="1" Text="{l:T slot}" Style="{StaticResource Text.Label}" />
                            <TextBlock Grid.Column="2" Text="{l:T equipment_empty_a_slot_to_free_it}" Style="{StaticResource Text.Label}" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Equipment}" Margin="20,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PartLabel}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding SlotLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" MaxDropDownHeight="420" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </ma:MaShapeBorder>

                <!-- Armor -->
                <ma:MaShapeBorder Margin="20,18" Padding="0,10">
                    <ma:MaShapeBorder.Style>
                        <Style TargetType="ma:MaShapeBorder" BasedOn="{StaticResource Panel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab}" Value="Armor">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ma:MaShapeBorder.Style>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="20,4,20,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T location}" Style="{StaticResource Text.Label}" />
                            <TextBlock Grid.Column="1" Text="{l:T front}" Style="{StaticResource Text.Label}" />
                            <TextBlock Grid.Column="2" Text="{l:T rear}" Style="{StaticResource Text.Label}" />
                            <TextBlock Grid.Column="3" Text="{l:T total_max}" Style="{StaticResource Text.Label}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Armor}" Margin="20,0" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Front, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left" Height="32" />
                                            <TextBox Grid.Column="2" Text="{Binding Rear, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left" Height="32"
                                                     Visibility="{Binding HasRear, Converter={StaticResource BoolToVisibility}}" />
                                            <!-- Total, "/" and max sit in shared columns (total right-aligned, max left-aligned),
                                                 so the slash lines up down the column whatever the totals' widths. -->
                                            <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="FontSize" Value="18" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverMax}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Resources>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ArmorTotal" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ArmorMax" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock HorizontalAlignment="Right">
                                                    <Run Text="{Binding Front, Mode=OneWay}" /><Run Text=" + " /><Run Text="{Binding Rear, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="/" Margin="12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Max, Mode=OneWay}" HorizontalAlignment="Left" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </ma:MaShapeBorder>
            </Grid>

            <!-- Traits (overlays the content row): the same full-height frame, header row and gutters as the other tabs. -->
            <ma:MaShapeBorder Grid.Row="1" Margin="20,18" Padding="0,10">
                <ma:MaShapeBorder.Style>
                    <Style TargetType="ma:MaShapeBorder" BasedOn="{StaticResource Panel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tab}" Value="Traits">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ma:MaShapeBorder.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T mech_traits}" Style="{StaticResource Text.Label}" Margin="20,4,20,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,0">
                            <TextBlock Text="{l:T traits_installed_on_this_mech_applied_with_the_r}" Style="{StaticResource Text.Muted}" FontSize="16" Margin="0,0,0,10" />
                            <!-- The 'Mech's traits in the same framed list as the Pilots page: name, description, remove. -->
                            <ma:MaShapeBorder Style="{StaticResource Panel}" Padding="0,8" ClipToShape="True" Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock Text="{l:T mech_has_no_traits}" Style="{StaticResource Text.Muted}" FontSize="16" Margin="14,6" TextWrapping="Wrap"
                                               Visibility="{Binding HasTraits, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <ItemsControl ItemsSource="{Binding Traits}" Grid.IsSharedSizeScope="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="14,8,8,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MechTraitRemove" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <ma:MaButton Grid.Column="1" Style="{StaticResource Button.Link}" Width="28" Height="28" Margin="8,0,0,0" ToolTip="{l:T remove_trait}"
                                                                     VerticalAlignment="Center"
                                                                     Command="{Binding DataContext.RemoveTraitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                     CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource Glyph.Close}" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                                  StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </ma:MaButton>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ma:MaShapeBorder>
                            <DockPanel>
                                <ma:MaButton DockPanel.Dock="Right" Content="{l:T add}" Command="{Binding AddTraitCommand}" Margin="8,0,0,0" />
                                <ComboBox ItemsSource="{Binding TraitChoices}" SelectedItem="{Binding TraitToAdd}" DisplayMemberPath="Label" MaxDropDownHeight="380"
                                          Tag="{l:T pick_a_trait_to_add}" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </ma:MaShapeBorder>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Void}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="20,14">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <ma:MaButton Content="{l:T import}" Command="{Binding ImportCommand}" Margin="0,0,8,0" ToolTip="{l:T load_a_mw5loadout_file}" />
                        <ma:MaButton Content="{l:T export}" Command="{Binding ExportCommand}" Margin="0,0,8,0" ToolTip="{l:T save_this_loadout_to_share_or_reuse}" />
                        <ma:MaButton Content="{l:T stock}" Command="{Binding ResetToStockCommand}" Margin="0,0,8,0" IsEnabled="{Binding HasStock}"
                                ToolTip="{l:T load_the_factory_loadout_applied_only_when_you_p}" />
                        <ma:MaButton Content="{l:T max_armor}" Command="{Binding MaxArmorCommand}" IsEnabled="{Binding HasStock}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{l:T fitted_parts_don_t_come_out_of_inventory}" Style="{StaticResource Text.Muted}" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <ma:MaButton Content="{l:T cancel}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" MinWidth="110" />
                        <ma:MaButton Content="{l:T apply}" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Command}" MinWidth="130" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Click the chassis picture to see it large. -->
            <sw:MechArtLightbox Grid.RowSpan="3" LinkText="{l:T view_on_sarna}" LoadingText="{l:T loading_picture}" NoPictureText="{l:T no_picture_available}" />
        </Grid>
    </ma:MaShapeBorder>
</Window>
