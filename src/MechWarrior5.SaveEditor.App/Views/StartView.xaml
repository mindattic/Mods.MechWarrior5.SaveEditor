<UserControl xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization">
    <Grid Margin="36,30,36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <ma:MaButton Content="{l:T rescan}" Command="{Binding RescanCommand}" Margin="0,0,10,0" />
                <ma:MaButton Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Button.Command}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Glyph.Open}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Brush.Void}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T browse_for_save}" Foreground="{DynamicResource Brush.Void}" FontWeight="Bold" />
                    </StackPanel>
                </ma:MaButton>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:T select_campaign}" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0">
                    <Run Text="{l:T campaigns_found_in}" /> <Run Text="{Binding SaveRoot, Mode=OneWay}" Foreground="{DynamicResource Brush.TextFaint}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0" Visibility="{Binding HasCampaigns, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ma:MaShapeBorder Style="{StaticResource Panel}" Padding="0,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T campaigns}" Style="{StaticResource Text.Section}" Margin="18,4,18,10" />
                    <ListBox ItemsSource="{Binding Campaigns}" SelectedItem="{Binding SelectedCampaign}" Style="{StaticResource List.Rows}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Background="Transparent" Cursor="Hand">
                                                <Rectangle x:Name="Wash" Fill="{DynamicResource Brush.AccentWash}" Opacity="0" />
                                                <Rectangle x:Name="Bar" Width="4" HorizontalAlignment="Left" Fill="{DynamicResource Brush.Accent}" Opacity="0" />
                                                <ContentPresenter Margin="18,10" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Wash" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Wash" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="16">
                                        <Run Text="{Binding Saves.Count, Mode=OneWay}" /> <Run Text="{l:T saves}" />
                                        <Run Text="{Binding CompanyGameDate, Mode=OneWay, StringFormat='  /  {0}'}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ma:MaShapeBorder>

            <ma:MaShapeBorder Grid.Column="2" Style="{StaticResource Panel}" Padding="0,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,4,18,10">
                        <TextBlock Text="{l:T double_click_a_save_to_open_it}" DockPanel.Dock="Right" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding SelectedCampaign.Name, StringFormat='SAVES  //  {0}'}" Style="{StaticResource Text.Section}" />
                    </DockPanel>
                    <ListBox x:Name="Saves" ItemsSource="{Binding SelectedCampaign.Saves}" Style="{StaticResource List.Rows}"
                             MouseDoubleClick="OnSaveDoubleClick" KeyDown="OnSaveKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Background="Transparent" Cursor="Hand">
                                                <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" />
                                                <ContentPresenter Margin="18,9" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.AccentWash}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Visibility="{Binding IsAutosave, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{l:T auto}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="{DynamicResource Brush.AccentWash}" BorderBrush="{DynamicResource Brush.Accent}"
                                                    Visibility="{Binding IsEditorSave, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:T written_by_this_editor}">
                                                <TextBlock Text="{l:T edited}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentHot}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StarSystem}" Style="{StaticResource Text.Muted}" FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:T game_date}" Style="{StaticResource Text.Label}" FontSize="13" />
                                        <TextBlock Text="{Binding GameDate}" FontSize="17" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{l:T reputation}" Style="{StaticResource Text.Label}" FontSize="13" />
                                        <TextBlock Text="{Binding Reputation}" FontSize="17" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{l:T saved}" Style="{StaticResource Text.Label}" FontSize="13" />
                                        <TextBlock Text="{Binding LastWrite, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="17" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ma:MaShapeBorder>
        </Grid>

        <ma:MaShapeBorder Grid.Row="1" Style="{StaticResource Panel}" Margin="0,22,0,0" VerticalAlignment="Top" Padding="28,24"
                         Visibility="{Binding HasCampaigns, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <StackPanel>
                <TextBlock Text="{l:T no_campaigns_found}" Style="{StaticResource Text.Section}" FontSize="22" />
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Text.Muted}"
                           Text="{l:T mw5_mercenaries_keeps_campaign_saves_under_local}" />
            </StackPanel>
        </ma:MaShapeBorder>
    </Grid>
</UserControl>
