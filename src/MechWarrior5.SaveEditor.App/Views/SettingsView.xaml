<UserControl xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,22,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="{l:T settings_title}" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

            <ma:MaShapeBorder Grid.Row="1" Style="{StaticResource Panel}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T settings_interface}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{l:T settings_language}" Style="{StaticResource Text.Label}" Margin="0,14,0,4" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Name" Width="240" HorizontalAlignment="Left" />
                    <TextBlock Text="{l:T settings_theme_hint}" Style="{StaticResource Text.Muted}" FontSize="16" Margin="0,14,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="{l:T settings_pictures}" Style="{StaticResource Text.Section}" Margin="0,24,0,0" />
                    <CheckBox Content="{l:T settings_download_pictures}" IsChecked="{Binding DownloadImages}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ma:MaButton Content="{l:T settings_clear_cache}" Command="{Binding ClearImageCacheCommand}" />
                        <TextBlock Text="{Binding CacheStatus}" Style="{StaticResource Text.Muted}" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ma:MaShapeBorder>

            <ma:MaShapeBorder Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T settings_game_data}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding MainViewSummary}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Text="{l:T settings_game_folder}" Style="{StaticResource Text.Label}" Margin="0,14,0,4" />
                    <DockPanel>
                        <ma:MaButton DockPanel.Dock="Right" Content="{l:T settings_browse}" Command="{Binding BrowseGameFolderCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T settings_auto_detect}" />
                    </DockPanel>
                    <ma:MaButton Content="{l:T settings_rescan}" Command="{Binding RescanGameCommand}" Style="{StaticResource Button.Command}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                    <TextBlock Text="{l:T settings_game_data_hint}" Style="{StaticResource Text.Muted}" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ma:MaShapeBorder>

            <ma:MaShapeBorder Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Padding="22,18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T settings_about}" Style="{StaticResource Text.Section}" />
                    <TextBlock FontSize="18" Margin="0,10,0,0">
                        <Run Text="MW5 Mercs Save Editor" FontWeight="Bold" /> <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentHot}" />
                    </TextBlock>
                    <TextBlock Text="{l:T settings_about_text}" Style="{StaticResource Text.Muted}" FontSize="16" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="15" Margin="0,8,0,0">
                        <Run Text="{l:T settings_file}" /> <Run Text="{Binding SettingsFile, Mode=OneWay}" />
                    </TextBlock>
                    <ma:MaButton Content="{l:T settings_project_page}" Command="{Binding OpenProjectPageCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </ma:MaShapeBorder>
        </Grid>
    </ScrollViewer>
</UserControl>
