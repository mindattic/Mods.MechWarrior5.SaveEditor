<UserControl xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Views.CompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization">
    <!--
        Fits the window without a page scrollbar: the tall IDENTITY panel pairs with the short ASSETS panel on the
        left, the short FINANCES panel with the tall DLC panel on the right, and both columns fill the page so the
        panels' bottoms line up. Each tall panel scrolls inside itself if the window is smaller.
    -->
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{l:T company_overview}" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

        <!-- Left column: identity, then assets -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ma:MaShapeBorder Style="{StaticResource Panel}" Padding="22,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{l:T identity}" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{l:T company_name}" Style="{StaticResource Text.Label}" Margin="0,14,0,4" />
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=LostFocus}" FontSize="20" />

                        <TextBlock Text="{l:T reputation}" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
                        <TextBox Text="{Binding Reputation, UpdateSourceTrigger=LostFocus}" Width="180" HorizontalAlignment="Left" />

                        <TextBlock Text="{l:T campaign_date}" Style="{StaticResource Text.Label}" Margin="0,16,0,2" />
                        <TextBlock Text="{Binding CampaignDate}" FontSize="20" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Width="150" Tag="{l:T yyyy_mm_dd}" />
                            <ma:MaButton Content="{l:T move_calendar}" Command="{Binding MoveDateCommand}" Margin="8,0,0,0"
                                    ToolTip="{l:T shifts_today_and_every_dated_event_together_so_t}" />
                        </StackPanel>

                        <TextBlock Text="{l:T transfer}" Style="{StaticResource Text.Section}" Margin="0,22,0,0" />
                        <TextBlock Text="{l:T move_mechs_pilots_and_stock_between_campaigns}" Style="{StaticResource Text.Muted}" FontSize="16" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <ma:MaButton Content="{l:T export_company}" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                            <ma:MaButton Content="{l:T import_company}" Command="{Binding ImportCommand}" />
                        </StackPanel>

                        <TextBlock Text="{l:T cantinas}" Style="{StaticResource Text.Section}" Margin="0,22,0,6"
                                   Visibility="{Binding HasCantinas, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox Content="{l:T cantinas_unlocked}" IsChecked="{Binding CantinasUnlocked}"
                                  Visibility="{Binding HasCantinas, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="{l:T opens_the_cantinas_without_waiting_for_the_story}" />

                        <StackPanel Visibility="{Binding HasMechTraits, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:T mech_traits_unlocked}" Style="{StaticResource Text.Section}" Margin="0,22,0,6" />
                            <ItemsControl ItemsSource="{Binding UnlockedTraits}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Height="28" Margin="0,0,6,6" Padding="8,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <ma:MaButton Style="{StaticResource Button.Link}" Margin="8,0,0,0" ToolTip="{l:T remove}" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.LockTraitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource Glyph.Close}" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                          StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform" />
                                                </ma:MaButton>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,4,0,0">
                                <ma:MaButton DockPanel.Dock="Right" Content="{l:T add}" Command="{Binding UnlockTraitCommand}" Margin="8,0,0,0" />
                                <ComboBox ItemsSource="{Binding TraitChoices}" SelectedItem="{Binding UnlockToAdd}" DisplayMemberPath="Label" MaxDropDownHeight="380"
                                          Tag="{l:T pick_a_trait_to_unlock}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </ma:MaShapeBorder>

            <!-- Readouts -->
            <ma:MaShapeBorder Grid.Row="1" Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T assets}" Style="{StaticResource Text.Section}" />
                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T mechbay}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding MechBayCount}" Style="{StaticResource Text.Readout}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T cold_storage}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding ColdStorageCount}" Style="{StaticResource Text.Readout}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T pilots}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding PilotCount}" Style="{StaticResource Text.Readout}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T items}" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding ItemCount}" Style="{StaticResource Text.Readout}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </ma:MaShapeBorder>
        </Grid>

        <!-- Right column: finances, then DLC content -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ma:MaShapeBorder Style="{StaticResource Panel}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T finances}" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{l:T available_c_bills}" Style="{StaticResource Text.Label}" Margin="0,14,0,2" />
                    <TextBlock Text="{Binding CBillsText}" Style="{StaticResource Text.Readout}" FontSize="42" />
                    <TextBlock Text="{l:T set_exact_amount}" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding CBills, UpdateSourceTrigger=LostFocus}" Width="260" HorizontalAlignment="Left" />
                    <WrapPanel Margin="0,14,0,0">
                        <ma:MaButton Content="{l:T 1m}" Command="{Binding AddCBillsCommand}" CommandParameter="1000000" Margin="0,0,8,8" MinWidth="80" />
                        <ma:MaButton Content="{l:T 10m}" Command="{Binding AddCBillsCommand}" CommandParameter="10000000" Margin="0,0,8,8" MinWidth="80" />
                        <ma:MaButton Content="{l:T 100m}" Command="{Binding AddCBillsCommand}" CommandParameter="100000000" Margin="0,0,8,8" MinWidth="80" />
                        <ma:MaButton Content="{l:T max}" Command="{Binding MaxCBillsCommand}" Style="{StaticResource Button.Command}" Margin="0,0,8,8" MinWidth="80"
                                ToolTip="{l:T 2_000_000_000_the_largest_amount_the_game_displa}" />
                    </WrapPanel>
                </StackPanel>
            </ma:MaShapeBorder>

            <ma:MaShapeBorder Grid.Row="1" Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="22,18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T dlc_content}" Style="{StaticResource Text.Section}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DlcNote}" Style="{StaticResource Text.Muted}" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <!-- The DLC list scrolls inside its panel rather than pushing the page past the window. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Dlcs}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <!-- One width for every DLC chip, set by the widest code. -->
                                            <ColumnDefinition Width="Auto" MinWidth="56" SharedSizeGroup="DlcCode" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Stretch" Margin="0,0,10,0" ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding Code}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="2" FontWeight="Bold" FontSize="15" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="{l:T company_not_in_campaign}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Owned}" Value="True">
                                                            <Setter Property="Text" Value="{l:T company_active}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </ma:MaShapeBorder>
        </Grid>
    </Grid>
</UserControl>
