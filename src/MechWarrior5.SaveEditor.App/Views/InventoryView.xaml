<UserControl xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization"
             xmlns:b="clr-namespace:MechWarrior5.Shared.Wpf.Behaviors;assembly=MechWarrior5.Shared.Wpf">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{l:T company_inventory}" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

        <!-- Stock on hand -->
        <ma:MaShapeBorder Grid.Row="1" Style="{StaticResource Panel}" Padding="0" ClipToShape="True">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom">
                            <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" /> <Run Text="{l:T units}" />
                        </TextBlock>
                        <TextBlock Text="{l:T on_hand}" Style="{StaticResource Text.Section}" FontSize="19" />
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}" Tag="{l:T filter_your_stock}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                    </Grid>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,12">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ma:MaButton Style="{StaticResource Button.Link}" Command="{Binding SelectAllVisibleCommand}" Margin="0,0,16,0">
                                <TextBlock Text="{l:T select_all}" FontWeight="Bold" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                            </ma:MaButton>
                            <ma:MaButton Style="{StaticResource Button.Link}" Command="{Binding ClearSelectionCommand}" Margin="0,0,16,0">
                                <TextBlock Text="{l:T clear}" FontWeight="Bold" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                            </ma:MaButton>
                            <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentHot}" /> <Run Text="{l:T selected}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Text="{Binding SetCount, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalContentAlignment="Center" Margin="0,0,8,0" />
                            <ma:MaButton Content="{l:T set_count}" Command="{Binding SetSelectedCountCommand}" Margin="0,0,8,0" IsEnabled="{Binding HasSelection}" />
                            <ma:MaButton Command="{Binding RemoveSelectedCommand}" Style="{StaticResource Button.Danger}" IsEnabled="{Binding HasSelection}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Glyph.Trash}" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T remove_2}" FontWeight="Bold" />
                                </StackPanel>
                            </ma:MaButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding ItemsView}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}"
                         b:CheckList.IsEnabled="True" Margin="8,0,4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Focusable="False" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" />
                                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="{Binding Tier, Converter={StaticResource HasValueToVisibility}}">
                                            <TextBlock Text="{Binding Tier}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentHot}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Asset}" Style="{StaticResource Text.Muted}" FontSize="14" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Grid.Column="3" Text="{Binding Health}" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Grid.Column="4" Text="{Binding Count, UpdateSourceTrigger=LostFocus}" Height="30" HorizontalContentAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ma:MaShapeBorder>

        <!-- Add from catalog -->
        <ma:MaShapeBorder Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="0" ClipToShape="True">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                    <TextBlock Text="{l:T requisition}" Style="{StaticResource Text.Section}" FontSize="19" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}" Tag="{l:T search_weapons_equipment_ammo}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding CatalogFilter}" />
                    </Grid>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,12">
                    <DockPanel>
                        <ma:MaButton DockPanel.Dock="Right" Command="{Binding AddSelectedCommand}" Style="{StaticResource Button.Command}" IsEnabled="{Binding HasCatalogSelection}">
                            <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Void}">
                                <Run Text="{l:T add}" /> <Run Text="{Binding CatalogSelectedCount, Mode=OneWay}" />
                            </TextBlock>
                        </ma:MaButton>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{l:T qty_each}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding AddCount, UpdateSourceTrigger=PropertyChanged}" Width="64" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding CatalogView}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}"
                         b:CheckList.IsEnabled="True" Margin="8,0,4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Focusable="False" Width="30" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TypeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" FontSize="15" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="{Binding Tier, Converter={StaticResource HasValueToVisibility}}">
                                        <TextBlock Text="{Binding Tier}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentHot}" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ma:MaShapeBorder>
    </Grid>
</UserControl>
