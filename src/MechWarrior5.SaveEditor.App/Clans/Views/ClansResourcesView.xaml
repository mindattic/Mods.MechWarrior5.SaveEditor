<UserControl xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization" xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One editable amount with quick-add steps. -->
        <DataTemplate x:Key="AmountTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Muted}" FontSize="14" TextWrapping="Wrap"
                               Visibility="{Binding Hint, Converter={StaticResource HasValueToVisibility}}" />
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Height="32"
                         HorizontalContentAlignment="Right" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <ma:MaButton Content="+10" Command="{Binding AddCommand}" CommandParameter="10" Margin="0,0,4,0" Padding="8,4" />
                    <ma:MaButton Content="+100" Command="{Binding AddCommand}" CommandParameter="100" Margin="0,0,4,0" Padding="8,4" />
                    <ma:MaButton Content="+1K" Command="{Binding AddCommand}" CommandParameter="1000" Padding="8,4" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Two columns of amounts in a full-width panel, lined up with the half-width panels above: each cell
             carries a 54px right gutter (18 page gutter + 2 x 18 panel padding) and the list reaches 54px past the
             panel's content, so the left column ends where the left panel's content ends and the right column starts
             where the right panel's content starts. -->
        <ItemsPanelTemplate x:Key="TwoColumns">
            <UniformGrid Columns="2" VerticalAlignment="Top" />
        </ItemsPanelTemplate>
        <Style x:Key="TwoColumnsCell" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="0,0,54,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Center"
                        Visibility="{Binding HonorLevel, Converter={StaticResource HasValueToVisibility}}">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.AccentHot}">
                        <Run Text="{l:T honor_level}" /> <Run Text="{Binding HonorLevel, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <TextBlock Text="{l:T resources}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
            </DockPanel>

            <ma:MaShapeBorder Grid.Row="1" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{l:T currencies}" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Currencies}" ItemTemplate="{StaticResource AmountTemplate}" />
                </StackPanel>
            </ma:MaShapeBorder>

            <ma:MaShapeBorder Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{l:T salvage}" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Salvage}" ItemTemplate="{StaticResource AmountTemplate}" />
                </StackPanel>
            </ma:MaShapeBorder>

            <!-- Crew (5 rows) and mech XP (one row per chassis) differ in length, so side by side one frame was left
                 half empty. Each spans the page instead, its rows in the same two columns as the panels above. -->
            <ma:MaShapeBorder Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{l:T crew}" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding CrewRows}" ItemTemplate="{StaticResource AmountTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" ItemContainerStyle="{StaticResource TwoColumnsCell}" Margin="0,0,-54,0" />
                </StackPanel>
            </ma:MaShapeBorder>

            <ma:MaShapeBorder Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{l:T mech_experience_mxp}" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,4" />
                    <TextBlock Text="{l:T per_chassis_experience_spent_on_mech_upgrades}" Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding MechXp}" ItemTemplate="{StaticResource AmountTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" ItemContainerStyle="{StaticResource TwoColumnsCell}" Margin="0,0,-54,0" />
                </StackPanel>
            </ma:MaShapeBorder>
        </Grid>
    </ScrollViewer>
</UserControl>
