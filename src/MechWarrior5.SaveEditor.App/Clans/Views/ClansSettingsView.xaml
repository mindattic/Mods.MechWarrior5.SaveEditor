<UserControl xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28,22,28,22" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="SETTINGS" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

        <ma:MaShapeBorder Style="{StaticResource Panel}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="SAVE FOLDER" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,8" />
                <DockPanel>
                    <ma:MaButton DockPanel.Dock="Right" Content="DEFAULT" Command="{Binding ResetFolderCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding SaveFolder, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>
                <TextBlock Text="Where MechWarrior 5: Clans keeps its campaign saves and the load-menu index (UserSaveMetaData)."
                           Style="{StaticResource Text.Muted}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </ma:MaShapeBorder>

        <ma:MaShapeBorder Style="{StaticResource Panel}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="MECH ART" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,8" />
                <CheckBox IsChecked="{Binding DownloadMechImages}" Content="Download chassis pictures from Sarna.net (cached on this PC)" />
            </StackPanel>
        </ma:MaShapeBorder>

        <ma:MaShapeBorder Style="{StaticResource Panel}">
            <StackPanel>
                <TextBlock Text="SAFETY" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}"
                           Text="The editor never changes a save the game wrote. Saving one creates a new save, listed in the game's load menu under the name you give it. Only saves this editor created are updated in place, and the previous version is kept as a .bak file. The load-menu index files are backed up the same way before they are updated." />
            </StackPanel>
        </ma:MaShapeBorder>
    </StackPanel>
</UserControl>
