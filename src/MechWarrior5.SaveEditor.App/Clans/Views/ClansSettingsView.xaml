<UserControl xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization" xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28,22,28,22" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{l:T settings}" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

        <ma:MaShapeBorder Style="{StaticResource Panel}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{l:T save_folder}" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,8" />
                <DockPanel>
                    <ma:MaButton DockPanel.Dock="Right" Content="{l:T default}" Command="{Binding ResetFolderCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding SaveFolder, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>
                <TextBlock Text="{l:T where_mechwarrior_5_clans_keeps_its_campaign_sav}"
                           Style="{StaticResource Text.Muted}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </ma:MaShapeBorder>

        <ma:MaShapeBorder Style="{StaticResource Panel}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{l:T mech_art}" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,8" />
                <CheckBox IsChecked="{Binding DownloadMechImages}" Content="{l:T download_chassis_pictures_from_sarna_net_cached}" />
            </StackPanel>
        </ma:MaShapeBorder>

        <ma:MaShapeBorder Style="{StaticResource Panel}">
            <StackPanel>
                <TextBlock Text="{l:T safety}" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}"
                           Text="{l:T the_editor_never_changes_a_save_the_game_wrote_s}" />
            </StackPanel>
        </ma:MaShapeBorder>
    </StackPanel>
</UserControl>
