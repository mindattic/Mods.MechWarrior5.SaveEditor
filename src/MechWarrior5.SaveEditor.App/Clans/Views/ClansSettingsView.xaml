<UserControl xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization" xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same layout as the Mercenaries settings page: two equal columns, an 18px gutter, a full-width panel below. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,22,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="{l:T settings}" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

            <ma:MaShapeBorder Grid.Row="1" Style="{StaticResource Panel}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T save_folder}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                    <DockPanel>
                        <ma:MaButton DockPanel.Dock="Right" Content="{l:T default}" Command="{Binding ResetFolderCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding SaveFolder, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <TextBlock Text="{l:T where_mechwarrior_5_clans_keeps_its_campaign_sav}"
                               Style="{StaticResource Text.Muted}" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ma:MaShapeBorder>

            <ma:MaShapeBorder Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{l:T mech_art}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                    <TextBlock Text="{l:T settings_pictures_offline}" TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding ArtStatus}" TextWrapping="Wrap" FontSize="16" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ma:MaButton Content="{l:T clans_art_choose}" Command="{Binding ChooseOodleCommand}" Margin="0,0,8,0" />
                        <ma:MaButton Content="{l:T clans_art_search}" Command="{Binding SearchAgainCommand}" />
                    </StackPanel>
                </StackPanel>
            </ma:MaShapeBorder>

            <!-- Installed Clans mods, and how the open save's assets trace to them. -->
            <ma:MaShapeBorder Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Padding="22,18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T compat_title}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CompatibilitySummary}" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="{l:T clans_mods_installed}" Style="{StaticResource Text.Label}" Margin="0,12,0,4"
                               Visibility="{Binding HasMods, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Mods}" Visibility="{Binding HasMods, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="15" Foreground="{DynamicResource Brush.TextMuted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Compatibility}" Margin="0,8,0,0" Visibility="{Binding HasCompatibility, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Asset}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}">
                                            <Run Text="{Binding Mod, Mode=OneWay}" FontWeight="Bold" /> <Run Text="{Binding Version, Mode=OneWay}" />
                                            <Run Text="-" /> <Run Text="{Binding Reason, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Url}" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                                                   Visibility="{Binding Url, Converter={StaticResource HasValueToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ma:MaShapeBorder>

            <ma:MaShapeBorder Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Padding="22,18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T safety}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}"
                               Text="{l:T the_editor_never_changes_a_save_the_game_wrote_s}" />
                </StackPanel>
            </ma:MaShapeBorder>
        </Grid>
    </ScrollViewer>
</UserControl>
