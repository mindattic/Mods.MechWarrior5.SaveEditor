<UserControl xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization" xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{l:T campaign_progress}" Style="{StaticResource Text.Title}" Margin="0,0,0,14" />

        <ma:MaShapeBorder Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Panel}">
            <UniformGrid Columns="4">
                <StackPanel>
                    <TextBlock Text="{l:T honor_level}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding HonorLevel, TargetNullValue='-'}" Style="{StaticResource Text.Readout}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T honor_experience}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding HonorExperience, StringFormat=N0, TargetNullValue='-'}" Style="{StaticResource Text.Readout}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T cycles_elapsed}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding Cycles, TargetNullValue='-'}" Style="{StaticResource Text.Readout}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T technician_pool}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding Technicians, TargetNullValue='-'}" Style="{StaticResource Text.Readout}" />
                </StackPanel>
            </UniformGrid>
        </ma:MaShapeBorder>

        <!-- The two lists size to their content (the taller one sets the row, so both bottoms match) and only grow
             to the page's height, then scroll: a top-aligned grid with one star row measures its content against the
             space left and takes the largest panel's height, so a 2-row queue no longer sits in a full-height frame.
             The lists keep a 14px (one chamfer) bottom inset so the last row clears the bottom-right cut and its tick. -->
        <Grid Grid.Row="3" Grid.ColumnSpan="3" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ma:MaShapeBorder Style="{StaticResource Panel}" Padding="0" ClipToShape="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T research_queue}" Style="{StaticResource Text.Section}" FontSize="19" Margin="18,14,18,8" />
                    <ListBox ItemsSource="{Binding Queue}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}" Margin="8,0,4,14" />
                </DockPanel>
            </ma:MaShapeBorder>

            <ma:MaShapeBorder Grid.Column="2" Style="{StaticResource Panel}" Padding="0" ClipToShape="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T completed_research}" Style="{StaticResource Text.Section}" FontSize="19" Margin="18,14,18,8" />
                    <ListBox ItemsSource="{Binding Completed}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}" Margin="8,0,4,14" />
                </DockPanel>
            </ma:MaShapeBorder>
        </Grid>
    </Grid>
</UserControl>
