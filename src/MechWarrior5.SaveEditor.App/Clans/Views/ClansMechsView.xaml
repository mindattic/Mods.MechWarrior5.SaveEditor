<UserControl xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansMechsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization"
             xmlns:b="clr-namespace:MechWarrior5.Shared.Wpf.Behaviors;assembly=MechWarrior5.Shared.Wpf">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" />
            <TextBlock Text="{l:T mechs}" Style="{StaticResource Text.Title}" />
        </DockPanel>

        <ma:MaShapeBorder Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="18,14,18,8">
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=120}" Tag="{l:T clans_filter_mechs}" />
                </Grid>

                <!-- Footer: selection on top, actions below (two rows so nothing overlaps). -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <ma:MaButton Style="{StaticResource Button.Link}" Command="{Binding SelectAllCommand}" Margin="0,0,14,0">
                                <TextBlock Text="{l:T select_all}" FontWeight="Bold" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                            </ma:MaButton>
                            <ma:MaButton Style="{StaticResource Button.Link}" Command="{Binding SelectDamagedCommand}" Margin="0,0,14,0">
                                <TextBlock Text="{l:T select_damaged}" FontWeight="Bold" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                            </ma:MaButton>
                            <ma:MaButton Style="{StaticResource Button.Link}" Command="{Binding SelectNoneCommand}" Margin="0,0,14,0">
                                <TextBlock Text="{l:T clear}" FontWeight="Bold" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                            </ma:MaButton>
                            <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center">
                                <Run Text="{Binding CheckedCount, Mode=OneWay}" Foreground="{DynamicResource Brush.AccentHot}" /> <Run Text="{l:T selected}" />
                            </TextBlock>
                        </WrapPanel>
                        <WrapPanel>
                            <ma:MaButton Command="{Binding RepairCommand}" Style="{StaticResource Button.Command}" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Glyph.Repair}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Brush.Void}" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T repair}" FontWeight="Bold" Foreground="{DynamicResource Brush.Void}" />
                                </StackPanel>
                            </ma:MaButton>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Width="48" HorizontalContentAlignment="Center" Margin="0,0,4,0"
                                         ToolTip="{l:T copies_of_each_ticked_mech}" />
                                <ma:MaButton Command="{Binding DuplicateCommand}" ToolTip="{l:T adds_copies_with_the_same_loadout_fully_repaired}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Glyph.Plus}" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                        <TextBlock Text="{l:T duplicate}" FontWeight="Bold" />
                                    </StackPanel>
                                </ma:MaButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,4,0" Tag="{l:T clans_mech_name_hint}" />
                                <ma:MaButton Command="{Binding RenameCommand}" Content="{l:T rename}" />
                            </StackPanel>
                            <ma:MaButton Command="{Binding RemoveCommand}" Style="{StaticResource Button.Danger}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Glyph.Trash}" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T remove_2}" FontWeight="Bold" />
                                </StackPanel>
                            </ma:MaButton>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding View}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}"
                         b:CheckList.IsEnabled="True" Margin="8,0,4,0" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Focusable="False" />
                                <ma:MaButton Grid.Column="1" Style="{StaticResource Button.Picture}" CommandParameter="{Binding SarnaTitle}" ToolTip="{l:T click_to_enlarge}"
                                                 Width="120" Height="90" HorizontalAlignment="Left">
                                        <Grid ClipToBounds="True">
                                            <Rectangle Fill="{DynamicResource Brush.Void}" />
                                            <Path Data="M14,0 L42,0 L56,24 L42,48 L14,48 L0,24 Z" Stretch="Uniform" Width="40" Height="34"
                                                  Stroke="{DynamicResource Brush.LineBright}" StrokeThickness="1.5" Fill="{DynamicResource Brush.Panel}" />
                                            <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}" />
                                            <Image b:MechArt.Title="{Binding SarnaTitle}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </ma:MaButton>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="16" />
                                    <TextBlock Text="{Binding Gear}" Style="{StaticResource Text.Muted}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="3" Style="{StaticResource Chip}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock FontSize="14" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="READY" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                                                        <Setter Property="Text" Value="DAMAGED" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ma:MaShapeBorder>
    </Grid>
</UserControl>
