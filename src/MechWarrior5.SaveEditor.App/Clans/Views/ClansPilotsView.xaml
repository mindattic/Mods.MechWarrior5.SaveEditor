<UserControl xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization" xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansPilotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:game="clr-namespace:MechWarrior5.Clans.SaveEditor.Core.Game;assembly=MechWarrior5.Clans.SaveEditor.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,22">
            <TextBlock Text="{l:T pilots}" Style="{StaticResource Text.Title}" Margin="0,0,0,4" />
            <TextBlock Text="{l:T clans_pilots_hint}" Style="{StaticResource Text.Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14" />
            <TextBlock Text="{l:T clans_no_pilots}" Style="{StaticResource Text.Muted}" FontSize="16" TextWrapping="Wrap"
                       Visibility="{Binding HasPilots, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <!-- Each card carries an 18px right gutter and the list reaches 18px past the page, so two cards sit
                 18px apart like the panels on the other pages. -->
            <ItemsControl ItemsSource="{Binding Pilots}" Margin="0,0,-18,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ma:MaShapeBorder Style="{StaticResource Panel}" Margin="0,0,18,18" Grid.IsSharedSizeScope="True">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <ma:MaButton DockPanel.Dock="Right" Content="{l:T clans_max_skills}" Command="{Binding MaxSkillsCommand}" Padding="10,4" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" FontSize="22" VerticalAlignment="Center" />
                                </DockPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T clans_unspent_xp}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Experience, UpdateSourceTrigger=LostFocus}" Height="32"
                                             HorizontalContentAlignment="Right" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                        <ma:MaButton Content="+1K" Command="{Binding AddXpCommand}" CommandParameter="1000" Margin="0,0,4,0" Padding="8,4" />
                                        <ma:MaButton Content="+10K" Command="{Binding AddXpCommand}" CommandParameter="10000" Padding="8,4" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Rank" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Action" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T skill}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Grid.Column="1" Text="{l:T clans_rank}" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Skills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Rank" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Action" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <DockPanel Grid.Column="1" Width="190" Margin="8,0,12,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Rank}" Width="22" TextAlignment="Right" FontSize="19" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Brush.AccentHot}" VerticalAlignment="Center" />
                                                        <Slider Minimum="1" Maximum="{Binding Source={x:Static game:ClansPilot.MaxRank}}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Rank}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <ma:MaButton Grid.Column="2" Style="{StaticResource Button.Link}" Command="{Binding RemoveCommand}" ToolTip="{l:T remove}" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource Glyph.Trash}" Style="{StaticResource Glyph}" />
                                                    </ma:MaButton>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,12,0,0" Visibility="{Binding CanAddSkills, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding SkillChoices}" SelectedItem="{Binding SkillToAdd}" DisplayMemberPath="Label" MaxDropDownHeight="380"
                                              Tag="{l:T clans_pick_skill}" />
                                    <ma:MaButton Grid.Column="1" Content="{l:T add}" Command="{Binding AddSkillCommand}" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </ma:MaShapeBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
