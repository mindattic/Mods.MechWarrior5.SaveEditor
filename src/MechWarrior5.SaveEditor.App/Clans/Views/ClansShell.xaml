<UserControl x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MechWarrior5.SaveEditor.App.Clans.ViewModels">
    <UserControl.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Grid Background="{DynamicResource Brush.Void}">
                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,22,18,18" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CAMPAIGN SAVE" Style="{StaticResource Text.Label}" FontSize="14" />
                        <TextBlock Text="{Binding SaveName}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,12" />
                        <TextBlock Text="KERENSKIES" Style="{StaticResource Text.Label}" FontSize="14" />
                        <TextBlock Text="{Binding KerenskiesText}" Style="{StaticResource Text.Readout}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,18">
                        <StackPanel Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="{DynamicResource Brush.AccentWash}" BorderBrush="{DynamicResource Brush.AccentDim}" BorderThickness="1"
                                    Padding="10,8" Margin="0,0,0,10" Visibility="{Binding IsOriginal, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource Brush.AccentHot}"
                                           Text="Original game save: saving creates a new save; this file is never changed." />
                            </Border>
                            <TextBlock Text="SAVE NAME (LOAD MENU)" Style="{StaticResource Text.Label}" FontSize="14" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Tag="Name shown in the game"
                                     ToolTip="How this save is listed in the game's load menu" />
                        </StackPanel>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource Button.Command}" Margin="0,0,0,8"
                                IsEnabled="{Binding HasDocument}" ToolTip="Ctrl+S. Original game saves are never overwritten.">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Glyph.Save}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Brush.Void}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SaveLabel}" Foreground="{DynamicResource Brush.Void}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding BrowseCommand}" Content="OPEN" ToolTip="Ctrl+O" />
                            <Button Grid.Column="2" Command="{Binding CloseCommand}" Content="CAMPAIGNS" />
                        </Grid>
                    </StackPanel>

                    <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Settings}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Repair}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="SETTINGS" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>

                    <StackPanel Margin="0,8,0,0" IsEnabled="{Binding HasDocument}">
                    <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Resources}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Resources}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Company}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="RESOURCES" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Mechs}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Mechs}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Mech}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="MECHS" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Inventory}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Inventory}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Inventory}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="INVENTORY" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Progress}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Progress}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Faction}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="PROGRESS" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Page -->
            <Grid Grid.Column="1" Background="{DynamicResource Brush.Base}">
                <Rectangle Fill="{DynamicResource Brush.Grid}" />
                <ContentControl Content="{Binding CurrentView}" Focusable="False" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="1" Background="{DynamicResource Brush.Void}">
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" />
            <TextBlock Text="{Binding Toast}" Margin="16,0" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}" />
        </Grid>
    </Grid>
</UserControl>
