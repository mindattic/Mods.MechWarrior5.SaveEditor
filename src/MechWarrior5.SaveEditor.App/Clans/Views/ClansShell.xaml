<UserControl xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization" xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MechWarrior5.SaveEditor.App.Clans.ViewModels">
    <UserControl.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Grid Background="{DynamicResource Brush.Void}">
                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,22,18,18" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:T campaign_save}" Style="{StaticResource Text.Label}" FontSize="14" />
                        <TextBlock Text="{Binding SaveName}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,12" />
                        <TextBlock Text="{l:T kerenskies}" Style="{StaticResource Text.Label}" FontSize="14" />
                        <TextBlock Text="{Binding KerenskiesText}" Style="{StaticResource Text.Readout}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,18">
                        <StackPanel Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="{DynamicResource Brush.AccentWash}" BorderBrush="{DynamicResource Brush.AccentDim}" BorderThickness="1"
                                    Padding="10,8" Margin="0,0,0,10" Visibility="{Binding IsOriginal, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource Brush.AccentHot}"
                                           Text="{l:T original_game_save_saving_creates_a_new_save_thi_c}" />
                            </Border>
                            <TextBlock Text="{l:T save_name_load_menu}" Style="{StaticResource Text.Label}" FontSize="14" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Tag="{l:T name_shown_in_the_game}"
                                     ToolTip="{l:T how_this_save_is_listed_in_the_game_s_load_menu}" />
                        </StackPanel>
                        <ma:MaButton Command="{Binding SaveCommand}" Style="{StaticResource Button.Command}" Margin="0,0,0,8"
                                IsEnabled="{Binding HasDocument}" ToolTip="{l:T ctrl_s_original_game_saves_are_never_overwritten}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Glyph.Save}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Brush.Void}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SaveLabel}" Foreground="{DynamicResource Brush.Void}" FontWeight="Bold" />
                            </StackPanel>
                        </ma:MaButton>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ma:MaButton Command="{Binding BrowseCommand}" Content="{l:T open}" ToolTip="{l:T ctrl_o}" />
                            <ma:MaButton Grid.Column="2" Command="{Binding CloseCommand}" Content="{l:T campaigns}" />
                        </Grid>
                    </StackPanel>

                    <ma:MaButton DockPanel.Dock="Bottom" Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Settings}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Repair}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="{l:T settings}" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        </StackPanel>
                    </ma:MaButton>

                    <StackPanel Margin="0,8,0,0" IsEnabled="{Binding HasDocument}">
                    <ma:MaButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Resources}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Resources}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Company}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="{l:T resources}" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        </StackPanel>
                    </ma:MaButton>
                    <ma:MaButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Mechs}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Mechs}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Mech}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="{l:T mechs}" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        </StackPanel>
                    </ma:MaButton>
                    <ma:MaButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Inventory}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Inventory}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Inventory}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="{l:T inventory}" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        </StackPanel>
                    </ma:MaButton>
                    <ma:MaButton Style="{StaticResource Nav.Item}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Progress}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Progress}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Faction}" Style="{StaticResource Glyph}" Width="16" Height="16" Margin="0,0,14,0" />
                            <TextBlock Text="{l:T progress}" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        </StackPanel>
                    </ma:MaButton>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Page -->
            <Grid Grid.Column="1" Background="{DynamicResource Brush.Base}">
                <Rectangle Fill="{DynamicResource Brush.Grid}" />
                <ContentControl Content="{Binding CurrentView}" Focusable="False" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="1" Background="{DynamicResource Brush.Void}">
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" />
            <TextBlock Text="{Binding Toast}" Margin="16,0" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource Brush.TextMuted}" />
        </Grid>
    </Grid>
</UserControl>
