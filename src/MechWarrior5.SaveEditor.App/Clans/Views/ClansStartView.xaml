<UserControl xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization" xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.Clans.Views.ClansStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Same title row as the Mercenaries start page: action on the right, the save folder inline on the title
             row (not under it) so the panel starts where it does on every other page. -->
        <DockPanel Margin="0,0,0,14">
            <ma:MaButton DockPanel.Dock="Right" Command="{Binding ReloadCommand}" Content="{l:T refresh}" VerticalAlignment="Bottom" />
            <TextBlock DockPanel.Dock="Left" Text="{l:T campaign_saves}" Style="{StaticResource Text.Title}" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="18,0,18,6" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                <Run Text="{l:T saves_found_in}" /> <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Brush.TextFaint}" />
            </TextBlock>
        </DockPanel>

        <!-- ClipToShape keeps the rows' backgrounds inside the chamfer cuts. -->
        <ma:MaShapeBorder Grid.Row="1" Style="{StaticResource Panel}" Padding="0" ClipToShape="True">
            <Grid>
                <ListBox ItemsSource="{Binding Saves}" Style="{StaticResource List.Rows}" ItemContainerStyle="{StaticResource List.Row}" Margin="8,14,4,14">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" />
                                        <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Visibility="{Binding IsAutoSave, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:T auto}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Campaign}" Style="{StaticResource Text.Muted}" FontSize="15" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SavedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm} UTC'}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Grid.Column="2" Text="{Binding Kerenskies, StringFormat='{}{0:N0} K'}" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentHot}" />
                                <ma:MaButton Grid.Column="3" Content="{l:T open}" Style="{StaticResource Button.Command}"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{l:T no_mechwarrior_5_clans_saves_were_found_here_use}"
                           Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                           TextAlignment="Center" FontSize="18">
                    <TextBlock.Visibility>
                        <Binding Path="HasSaves" Converter="{StaticResource BoolToVisibility}" ConverterParameter="Invert" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </ma:MaShapeBorder>
    </Grid>
</UserControl>
