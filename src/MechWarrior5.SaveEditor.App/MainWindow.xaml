<Window xmlns:ma="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf" x:Class="MechWarrior5.SaveEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization"
        xmlns:vm="clr-namespace:MechWarrior5.SaveEditor.App.ViewModels"
        Title="{Binding Current.WindowTitle}" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Base}"
        FontFamily="{StaticResource Font.Hud}" Icon="Assets/app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One line: game tabs on the far left, the open file in between, the app title and window buttons on the far right. -->
        <Grid Background="{DynamicResource Brush.Void}">
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{l:T choose_the_game_to_edit}">
                    <ma:MaButton Style="{StaticResource Tab.Game}" Content="{l:T mercenaries}" GroupName="Game" IsChecked="{Binding IsMercsGame}" />
                    <ma:MaButton Style="{StaticResource Tab.Game}" Content="{l:T clans}" GroupName="Game" IsChecked="{Binding IsClansGame}" Margin="-14,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Current.SaveTitle}" ToolTip="{Binding Current.FileName}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="18,0,0,0"
                           Visibility="{Binding Current.HasDocument, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                <TextBlock Text="{l:T unsaved_changes}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.AccentHot}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="{Binding Current.IsDirty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Image Source="Assets/app.ico" Width="20" Height="20" Margin="0,0,10,0" />
                    <TextBlock Text="MW5 " FontWeight="Bold" FontSize="19" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="{l:T save_editor}" FontWeight="SemiBold" FontSize="19" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <ma:MaButton Style="{StaticResource Button.Chrome}" Click="OnMinimize" ToolTip="{l:T minimize}">
                    <Path Data="{StaticResource Glyph.Minimize}" Style="{StaticResource Glyph}" Width="11" Height="11" />
                </ma:MaButton>
                <ma:MaButton Style="{StaticResource Button.Chrome}" Click="OnMaximize" ToolTip="{l:T maximize}">
                    <Path Data="{StaticResource Glyph.Maximize}" Style="{StaticResource Glyph}" Width="11" Height="11" />
                </ma:MaButton>
                <ma:MaButton Style="{StaticResource Button.ChromeClose}" Click="OnClose" ToolTip="{l:T close}">
                    <Path Data="{StaticResource Glyph.Close}" Style="{StaticResource Glyph}" Width="11" Height="11" />
                </ma:MaButton>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding Current}" Focusable="False" />
    </Grid>
</Window>
