<Window x:Class="MechWarrior5.SaveEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MechWarrior5.SaveEditor.App.Localization"
        xmlns:vm="clr-namespace:MechWarrior5.SaveEditor.App.ViewModels"
        Title="{Binding Current.WindowTitle}" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Base}"
        FontFamily="{StaticResource Font.Hud}" Icon="Assets/app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: game tabs on the left, theme chips and window buttons on the right. -->
        <Grid Background="{DynamicResource Brush.Void}">
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/app.ico" Width="20" Height="20" Margin="0,0,10,0" />
                <TextBlock Text="MW5 " FontWeight="Bold" FontSize="19" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{l:T save_editor}" FontWeight="SemiBold" FontSize="19" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{l:T choose_the_game_to_edit}">
                    <RadioButton Style="{StaticResource Toggle.Chip}" Content="{l:T mercenaries}" Height="28" GroupName="Game"
                                 IsChecked="{Binding IsMercsGame}" />
                    <RadioButton Style="{StaticResource Toggle.Chip}" Content="{l:T clans}" Height="28" GroupName="Game"
                                 IsChecked="{Binding IsClansGame}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding Current.FileName, StringFormat='   [{0}]'}" FontSize="17" Foreground="{DynamicResource Brush.TextFaint}"
                           Visibility="{Binding Current.HasDocument, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                <TextBlock Text="{l:T unsaved_changes}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.AccentHot}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="{Binding Current.IsDirty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{l:T interface_theme_remembered_between_runs}">
                    <ToggleButton Style="{StaticResource Toggle.Chip}" Content="{l:T mercs}" Height="26" IsChecked="{Binding Current.IsMercsTheme}" />
                    <ToggleButton Style="{StaticResource Toggle.Chip}" Content="{l:T clans}" Height="26" IsChecked="{Binding Current.IsClansTheme}" Margin="0" />
                </StackPanel>
                <Button Style="{StaticResource Button.Chrome}" Click="OnMinimize" ToolTip="{l:T minimize}">
                    <Path Data="{StaticResource Glyph.Minimize}" Style="{StaticResource Glyph}" Width="11" Height="11" />
                </Button>
                <Button Style="{StaticResource Button.Chrome}" Click="OnMaximize" ToolTip="{l:T maximize}">
                    <Path Data="{StaticResource Glyph.Maximize}" Style="{StaticResource Glyph}" Width="11" Height="11" />
                </Button>
                <Button Style="{StaticResource Button.ChromeClose}" Click="OnClose" ToolTip="{l:T close}">
                    <Path Data="{StaticResource Glyph.Close}" Style="{StaticResource Glyph}" Width="11" Height="11" />
                </Button>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding Current}" Focusable="False" />
    </Grid>
</Window>
