<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- Whole-number versions only (MindAttic rule): each release bumps the major. 1.0.0 was the first, hand-uploaded file;
         2.0.0 is the MindAttic.Components UI rewrite (M5SE-T98). -->
    <Version>2.0.0</Version>
    <Company>MindAttic</Company>
    <Product>MW5 Save Editor</Product>
  </PropertyGroup>
</Project>
